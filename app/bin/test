#!/bin/sh
# needle's Qt tests (offscreen) and the engine's Rust tests.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/needle_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./needle_tests

cargo test --locked --manifest-path "$ROOT/../engine/Cargo.toml"
